                            </padding>
                        </VBox>
                        <VBox style="-fx-background-color: ghostwhite; -fx-background-radius: 15;">
                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Privacy Statement" wrappingWidth="325.0">
                                    <font>
                                        <Font name="Leelawadee UI Bold" size="15.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </Text>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="PetPal only stores information needed for the app to function, including usernames, hashed passwords, pet details, and pet statistics. Passwords are not stored in plain text and are hashed before being saved." wrappingWidth="325.0">
                                    <font>
                                        <Font name="Leelawadee UI" size="12.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </Text>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="User and pet data is stored locally in an SQLite database. The conversation feature may send the user's message and current pet context, such as pet name, type, and stats, to an external AI service to generate a response. Users should avoid entering sensitive personal information into the chat feature." wrappingWidth="325.0">
                                    <font>
                                        <Font name="Leelawadee UI" size="12.0" />
