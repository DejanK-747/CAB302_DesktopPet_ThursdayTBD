                            <children>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="About PetPal" wrappingWidth="325.0">
                                    <font>
                                        <Font name="Leelawadee UI Bold" size="15.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </Text>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="PetPal is a virtual pet companion app that lets users adopt, care for, and interact with a digital pet. Users can monitor their pet's hunger, energy, affection, and boredom, then improve these stats through activities such as feeding, brushing, and stroking." wrappingWidth="325.0">
                                    <font>
                                        <Font name="Leelawadee UI" size="12.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </Text>
                                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="The app combines entertainment with core software engineering features, including account login, local database storage, object-oriented design, animated pet behaviour, and AI-powered pet conversations. It is intended for users who enjoy casual simulation games and virtual companion experiences." wrappingWidth="325.0">
                                    <font>
                                        <Font name="Leelawadee UI" size="12.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </Text>
                            </children>
                            <padding>
